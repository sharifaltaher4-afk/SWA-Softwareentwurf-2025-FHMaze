FormCollectionStrategy      ..>  GoAction                   : "®create¯"
FormCollectionStrategy      ..|>  INavigationStrategy        
FormCollectionStrategy     "1" *--> "fallbackStrategy\n1" INavigationStrategy        
FormCollectionStrategy     "1" *--> "maze\n1" Maze                       
