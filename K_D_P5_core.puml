Navigator                  "1" *--> "strategy\n1" INavigationStrategy        
Navigator                  "1" *--> "maze\n1" Maze                       
SheetManager                ..|>  ISheetManager               
SimpleNavigationStrategy    ..>  GoAction                   : "®create¯"
SimpleNavigationStrategy    ..|>  INavigationStrategy        
SimpleNavigationStrategy   "1" *--> "maze\n1" Maze                       
