KickManager                "1" *--> "levelDetector\n1" ILevelDetector              
LevelDetector               ..|>  ILevelDetector              
NavigationStrategyFactory   ..>  FormCollectionStrategy     : "®create¯"
NavigationStrategyFactory   ..>  INavigationStrategy         
