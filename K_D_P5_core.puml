GameCommunication           ..>  Action                      
GameController              ..>  Action                      
GameController             "1" *--> "actionResultTracker\n1" ActionResultTracker        
GameController              ..>  ActionResultTracker        : "®create¯"
GameController             "1" *--> "config\n1" BotConfig                  
GameController              ..>  FormCollectionStrategy      
GameController              ..>  FormManager                 
GameController             "1" *--> "comm\n1" GameCommunication          
GameController              ..>  GoAction                   : "®create¯"
GameController              ..>  INavigationStrategy         
GameController              ..>  INavigationStrategyFactory 
GameController              ..>  ISheetManager               
GameController             "1" *--> "kickManager\n1" KickManager                
GameController              ..>  KickManager                : "®create¯"
GameController              ..>  LevelDetector               
GameController              ..>  Maze                        
GameController              ..>  Navigator                  : "®create¯"
GameController             "1" *--> "navigator\n1" Navigator                  
GameController              ..>  StrategyType               
GoAction                    --|>  Action                      
INavigationStrategy         ..>  GoAction                    
INavigationStrategyFactory  ..>  INavigationStrategy         
INavigationStrategyFactory  ..>  Maze                        
