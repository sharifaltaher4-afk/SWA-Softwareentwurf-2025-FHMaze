FormCollectionStrategy     "1" *--> "fallbackStrategy\n1" INavigationStrategy        
FormCollectionStrategy     "1" *--> "pathFinder\n1" IPathFinder                
FormCollectionStrategy      ..>  SimpleNavigationStrategy   : "®create¯"
SimpleNavigationStrategy    ..|>  INavigationStrategy        
