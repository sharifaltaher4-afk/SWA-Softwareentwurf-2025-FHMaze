@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

class BFSPathFinderStrategy
class FormCollectionStrategy
interface INavigationStrategy << interface >>
interface IPathFinder << interface >>
class SimpleNavigationStrategy

BFSPathFinderStrategy       ..>  INavigationStrategy        
BFSPathFinderStrategy       ..|>  IPathFinder                
